# Copy to .env and fill in. .env is git-ignored: NEVER commit a real key.
KYA_LLM=openai                 # openai or anthropic
KYA_LLM_MODEL=                 # model name for browser-use, e.g. the cheap one from your provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Stagehand uses provider/model, e.g. openai/gpt-5.4-mini
KYA_STAGEHAND_MODEL=
